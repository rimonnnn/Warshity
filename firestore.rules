rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // ACCOUNT SHARES (Invitations)
    // ============================================================
    // Schema: { fromUid, fromEmail, toEmail, status, createdAt,
    //           respondedAt (optional), sharedAccountId (optional) }
    //
    // CRITICAL: The read rule must NOT check resource.data.status.
    // watchReceivedInvitations() uses .where('status', isEqualTo: 'pending')
    // as a query filter. When the recipient Accepts, respondToInvitation()
    // changes status from 'pending' to 'accepted'. Firestore real-time
    // listeners require the CLIENT to be able to READ the updated
    // document. If the read rule checks status, the listener gets
    // PERMISSION_DENIED after the status change.
    match /account_shares/{invitationId} {
      allow read: if request.auth != null
        && resource.data.toEmail == request.auth.token.email;

      allow create: if request.auth != null
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.fromEmail == request.auth.token.email
        && request.resource.data.toEmail is string
        && request.resource.data.toEmail != request.auth.token.email
        && request.resource.data.status == 'pending';

      allow update: if request.auth != null
        && resource.data.toEmail == request.auth.token.email
        && request.resource.data.status in ['accepted', 'rejected'];

      allow delete: if false;
    }

    // ============================================================
    // SHARED ACCOUNTS
    // ============================================================
    // Schema: { members: [uid1, uid2], invitationId, createdAt }
    // Document ID == invitationId
    //
    // Created by recipient (B) during accept flow.
    // Members list is [senderUid, recipientUid].
    match /shared_accounts/{sharedAccountId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.members;

      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() == 2;

      allow update: if false;

      allow delete: if request.auth != null
        && request.auth.uid in resource.data.members;
    }

    // ============================================================
    // USER SHARED ACCOUNTS (per-user mapping)
    // ============================================================
    // Schema: { sharedAccountId, members: [uid1, uid2], invitationId, createdAt }
    // Document ID == user's UID
    //
    // During accept flow, B's device creates BOTH:
    //   - user_shared_accounts/{A_uid}
    //   - user_shared_accounts/{B_uid}
    // So B writes to A's document path.
    match /user_shared_accounts/{uid} {
      allow read: if request.auth != null
        && request.auth.uid == uid;

      allow create: if request.auth != null
        && (
          request.auth.uid == uid
          || request.auth.uid in request.resource.data.members
        );

      allow update: if false;

      allow delete: if request.auth != null
        && (
          request.auth.uid == uid
          || (
            resource.data.sharedAccountId != null
            && exists(/databases/$(database)/documents/shared_accounts/$(resource.data.sharedAccountId))
            && request.auth.uid in get(/databases/$(database)/documents/shared_accounts/$(resource.data.sharedAccountId)).data.members
          )
        );
    }

    // ============================================================
    // USERS (account data - NEVER shared)
    // ============================================================
    // Schema: { uid, email, ownerName, shopName, activity }
    // Document ID == Firebase Auth UID
    match /users/{userId} {
      allow read: if request.auth != null
        && request.auth.uid == userId;

      allow create: if request.auth != null
        && request.auth.uid == userId;

      allow update: if request.auth != null
        && request.auth.uid == userId;

      allow delete: if false;
    }

    // ============================================================
    // BUSINESS CATEGORIES (global - NOT affected by sharing)
    // ============================================================
    // Schema: { name, createdAt }
    // Read: any authenticated user (registration dropdown)
    // Create: any authenticated user (during registration)
    match /business_categories/{categoryId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.name is string
        && request.resource.data.name != '';

      allow update, delete: if false;
    }

    // ============================================================
    // HELPER: Shared access check for business docs
    // ============================================================
    // Checks if the requesting user can access a business document
    // via ownership OR shared account membership.
    //
    // Condition 1: userId match (owner)
    // Condition 2: sharedAccountId match (shared member, post-setup)
    // Condition 3: userId in members list (during accept setup,
    //              before sharedAccountId is added to the doc)
    //
    // After unsharing: user_shared_accounts docs are deleted,
    //   so conditions 2 and 3 fail. Only condition 1 (owner) applies.

    // ============================================================
    // CLIENTS
    // ============================================================
    // Schema: { name, phone, address, balance, hasDebt,
    //           totalPurchases, orderCount, userId, sharedAccountId? }
    match /clients/{clientId} {

      function canAccessClient() {
        let uid = request.auth.uid;
        return resource.data.userId == uid
          || (
            exists(/databases/$(database)/documents/user_shared_accounts/$(uid))
            && let userMapping = get(/databases/$(database)/documents/user_shared_accounts/$(uid)).data
            && (
              (resource.data.sharedAccountId != null
                 && resource.data.sharedAccountId == userMapping.sharedAccountId)
              || resource.data.userId in userMapping.members
            )
          );
      }

      function canCreateClient() {
        let uid = request.auth.uid;
        let saId = request.resource.data.sharedAccountId;
        return request.resource.data.userId == uid
          && (
            saId == null
            || saId == ''
            || (
              exists(/databases/$(database)/documents/user_shared_accounts/$(uid))
              && saId == get(/databases/$(database)/documents/user_shared_accounts/$(uid)).data.sharedAccountId
            )
          );
      }

      function canUpdateClient() {
        let uid = request.auth.uid;
        return canAccessClient()
          && request.resource.data.userId == resource.data.userId
          && (
            request.resource.data.sharedAccountId == resource.data.sharedAccountId
            || (
              exists(/databases/$(database)/documents/user_shared_accounts/$(uid))
              && request.resource.data.sharedAccountId == get(/databases/$(database)/documents/user_shared_accounts/$(uid)).data.sharedAccountId
            )
          );
      }

      allow read: if request.auth != null && canAccessClient();
      allow create: if request.auth != null && canCreateClient();
      allow update: if request.auth != null && canUpdateClient();
      allow delete: if request.auth != null && canAccessClient();
    }

    // ============================================================
    // PRODUCTS
    // ============================================================
    // Schema: { name, barcode, category, price, quantity, unit,
    //           imageurl, userId, sharedAccountId? }
    match /products/{productId} {

      function canAccessProduct() {
        let uid = request.auth.uid;
        return resource.data.userId == uid
          || (
            exists(/databases/$(database)/documents/user_shared_accounts/$(uid))
            && let userMapping = get(/databases/$(database)/documents/user_shared_accounts/$(uid)).data
            && (
              (resource.data.sharedAccountId != null
                 && resource.data.sharedAccountId == userMapping.sharedAccountId)
              || resource.data.userId in userMapping.members
            )
          );
      }

      function canCreateProduct() {
        let uid = request.auth.uid;
        let saId = request.resource.data.sharedAccountId;
        return request.resource.data.userId == uid
          && (
            saId == null
            || saId == ''
            || (
              exists(/databases/$(database)/documents/user_shared_accounts/$(uid))
              && saId == get(/databases/$(database)/documents/user_shared_accounts/$(uid)).data.sharedAccountId
            )
          );
      }

      function canUpdateProduct() {
        let uid = request.auth.uid;
        return canAccessProduct()
          && request.resource.data.userId == resource.data.userId
          && (
            request.resource.data.sharedAccountId == resource.data.sharedAccountId
            || (
              exists(/databases/$(database)/documents/user_shared_accounts/$(uid))
              && request.resource.data.sharedAccountId == get(/databases/$(database)/documents/user_shared_accounts/$(uid)).data.sharedAccountId
            )
          );
      }

      allow read: if request.auth != null && canAccessProduct();
      allow create: if request.auth != null && canCreateProduct();
      allow update: if request.auth != null && canUpdateProduct();
      allow delete: if request.auth != null && canAccessProduct();
    }

    // ============================================================
    // CATEGORIES (per-user, affected by sharing)
    // ============================================================
    // Schema: { name, userId, sharedAccountId? }
    match /categories/{categoryId} {

      function canAccessCategory() {
        let uid = request.auth.uid;
        return resource.data.userId == uid
          || (
            exists(/databases/$(database)/documents/user_shared_accounts/$(uid))
            && let userMapping = get(/databases/$(database)/documents/user_shared_accounts/$(uid)).data
            && (
              (resource.data.sharedAccountId != null
                 && resource.data.sharedAccountId == userMapping.sharedAccountId)
              || resource.data.userId in userMapping.members
            )
          );
      }

      function canCreateCategory() {
        let uid = request.auth.uid;
        let saId = request.resource.data.sharedAccountId;
        return request.resource.data.userId == uid
          && (
            saId == null
            || saId == ''
            || (
              exists(/databases/$(database)/documents/user_shared_accounts/$(uid))
              && saId == get(/databases/$(database)/documents/user_shared_accounts/$(uid)).data.sharedAccountId
            )
          );
      }

      function canUpdateCategory() {
        let uid = request.auth.uid;
        return canAccessCategory()
          && request.resource.data.userId == resource.data.userId
          && (
            request.resource.data.sharedAccountId == resource.data.sharedAccountId
            || (
              exists(/databases/$(database)/documents/user_shared_accounts/$(uid))
              && request.resource.data.sharedAccountId == get(/databases/$(database)/documents/user_shared_accounts/$(uid)).data.sharedAccountId
            )
          );
      }

      allow read: if request.auth != null && canAccessCategory();
      allow create: if request.auth != null && canCreateCategory();
      allow update: if request.auth != null && canUpdateCategory();
      allow delete: if request.auth != null && canAccessCategory();
    }

    // ============================================================
    // INVOICES
    // ============================================================
    // Schema: { invoiceId, customerId, customerName, createdAt,
    //           items[], subtotal, discount, total, paidAmount,
    //           remainingAmount, stockDeducted, userId, sharedAccountId? }
    //
    // NOTE: finalizeInvoice() uses transaction.set() on existing invoices,
    // which overwrites the document including userId. This is existing
    // behavior - when A finalizes B's shared invoice, userId changes
    // from B to A. Therefore we CANNOT enforce userId immutability
    // on invoice updates. We DO enforce sharedAccountId validation.
    match /invoices/{invoiceId} {

      function canAccessInvoice() {
        let uid = request.auth.uid;
        return resource.data.userId == uid
          || (
            exists(/databases/$(database)/documents/user_shared_accounts/$(uid))
            && let userMapping = get(/databases/$(database)/documents/user_shared_accounts/$(uid)).data
            && (
              (resource.data.sharedAccountId != null
                 && resource.data.sharedAccountId == userMapping.sharedAccountId)
              || resource.data.userId in userMapping.members
            )
          );
      }

      function canCreateInvoice() {
        let uid = request.auth.uid;
        let saId = request.resource.data.sharedAccountId;
        return request.resource.data.userId == uid
          && (
            saId == null
            || saId == ''
            || (
              exists(/databases/$(database)/documents/user_shared_accounts/$(uid))
              && saId == get(/databases/$(database)/documents/user_shared_accounts/$(uid)).data.sharedAccountId
            )
          );
      }

      function canUpdateInvoice() {
        let uid = request.auth.uid;
        return canAccessInvoice()
          && (
            request.resource.data.sharedAccountId == resource.data.sharedAccountId
            || request.resource.data.sharedAccountId == null
            || (
              exists(/databases/$(database)/documents/user_shared_accounts/$(uid))
              && request.resource.data.sharedAccountId == get(/databases/$(database)/documents/user_shared_accounts/$(uid)).data.sharedAccountId
            )
          );
      }

      allow read: if request.auth != null && canAccessInvoice();
      allow create: if request.auth != null && canCreateInvoice();
      allow update: if request.auth != null && canUpdateInvoice();
      allow delete: if request.auth != null && canAccessInvoice();
    }
  }
}
